# Copy to .env next to compose.yaml. scripts/deploy-nahida.ps1 writes this file for you.
MCV_IMAGE=multiplayer-choicer-voicer:0.1.0
MCV_BIND_ADDRESS=192.168.50.9
MCV_PORT=3090

# Optional tuning
LOG_LEVEL=info
PACK_CACHE_MAX_GB=20
DOWNLOAD_MAX_MB=2048
UPLOAD_MAX_MB=2048
VIDEO_MAX_HEIGHT=720
VIDEO_PRESET=veryfast
VIDEO_CRF=27
FFMPEG_THREADS=0
ROOM_IDLE_HOURS=6
CATALOG_REFRESH_HOURS=6
